---
config:
  layout: elk
  flowchart:
    curve: linear
---
flowchart TB
  App["Frontend<br/>(Android app)"]
  SignIn["Google Sign-In"]

  subgraph Backend["Back end: one Node.js / Express server"]
    direction LR
    Users["Users"]
    Favs["Favorites"]
    Gems["Gems<br/>(incl. comments, ratings)"]
    Feed["Live Feed"]
  end

  Places["Google Places API"]

  subgraph DBs["MongoDB"]
    direction LR
    UsersDB[("Users DB")]
    FavsDB[("Favorites DB")]
    GemsDB[("Gems DB")]
    CommentsDB[("Comments DB")]
    RatingsDB[("Ratings DB")]
  end

  App -->|"getCredential (Google ID token)"| SignIn
  App -->|"POST /user/auth/google<br/>GET, PATCH /user/me"| Users
  App -->|"GET, POST /user/favorites<br/>DELETE /user/favorites/:placeId"| Favs
  App -->|"GET, POST /gem; GET /gem/nearby, /within, /newest<br/>GET /place/nearby<br/>GET, POST /gem/:pk/comments<br/>GET, PUT /gem/:pk/rating"| Gems
  App <-->|"WebSocket /feed: subscribe ⇄<br/>subscribed, gem.added, gem.updated"| Feed

  Favs -->|"reqJwt, currentUser"| Users
  Gems -->|"reqJwt, currentUser"| Users
  Favs -->|"hasGem, getGems"| Gems
  Gems -->|"publishGemAdded, publishGemUpdated"| Feed

  Users -->|"verifyIdToken"| SignIn
  Gems -->|"getPlace, searchNearby"| Places

  Users --> UsersDB
  Favs --> FavsDB
  Gems --> GemsDB
  Gems --> CommentsDB
  Gems --> RatingsDB
