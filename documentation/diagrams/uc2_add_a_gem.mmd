sequenceDiagram
  actor U as Signed-in User
  participant F as :Frontend
  participant G as :Gems
  participant US as :Users
  participant P as :Google Places API
  participant GDB as :Gems DB
  participant LF as :Live Feed
  participant OF as :Frontend (other users)

  Note over U,P: Choose a place to add (included use case)
  U->>+F: tap "Add gem", select type filters T
  F->>+G: GET /place/nearby?lat&lng&type=T (user's location)
  G->>+P: searchNearby(center: lat, lng, radius: 200 m, includedTypes: T)
  P-->>-G: places
  G->>+GDB: gems.find({ name: { $in: place names } }, { name: 1 })
  GDB-->>-G: names that are already gems
  G-->>-F: 200 [{ name, displayName, distance, isGem }]
  F-->>-U: nearby places, nearest first

  U->>+F: pick place "places/{id}"
  F->>+G: POST /gem { name, latitude, longitude } + Bearer JWT
  G->>+US: reqJwt(JWT)
  US-->>-G: user (401 to Frontend if the JWT is invalid)
  G->>+GDB: gems.exists({ name })
  GDB-->>-G: true or false
  alt already a gem
    G-->>F: 409 { message: "Gem already exists." }
    F-->>U: "This place is already a gem"
  else not a gem yet
    G->>+P: getPlace(name)
    P-->>-G: place { location, primaryType, rating, userRatingCount }
    alt place within 200 m of the user
      G->>G: computeGemScore(rating, userRatingCount)
      G->>+GDB: gems.insertOne({ name, place, score, addedBy: user.id, ... })
      GDB-->>-G: inserted
      G->>+LF: publishGemAdded(gem)
      LF-)OF: { type: "gem.added", gem } (each app whose area contains the gem)
      LF-->>-G: number of apps notified
      G-->>F: 201 gem
      F-->>U: the new gem on the map
    else too far, or no such place
      G-->>-F: 422 { message: "Too far from place." | "Place does not exist." }
      F-->>-U: "Move closer to the place" or "This place can't be added"
    end
  end
  Note over G,P: If Google Places is unavailable: 502, nothing is stored
