sequenceDiagram
  actor GU as Guest
  participant F as :Frontend
  participant SI as :Google Sign-In
  participant US as :Users
  participant DB as :Database

  GU->>+F: tap "Sign in with Google"
  F->>+SI: get a Google ID token
  alt Guest picks an account
    SI-->>F: Google ID token
    F->>+US: POST /user/auth/google { idToken }
    US->>+SI: verify the ID token
    alt token valid
      SI-->>US: Google account ID and name
      US->>+DB: find the user, or create them on their first sign-in
      alt database available
        DB-->>US: user
        US->>US: create a login token (valid 7 days)
        US-->>F: 200 { login token }
        F->>F: store the login token
        F-->>GU: the dashboard (now a Signed-in User)
      else database error
        DB-->>-US: error
        US-->>F: 500 "Login failed."
        F-->>GU: "Sign-in failed, try again later"
      end
    else token rejected or expired
      SI-->>-US: invalid
      US-->>-F: 401 "Login failed."
      F-->>GU: "Sign-in failed, try again"
    end
  else Guest cancels, or no Google account on the phone
    SI-->>-F: no credential
    F-->>-GU: stays on the sign-in screen
  end
  Note over GU,DB: If the server can't be reached, the Frontend shows "No connection, try again"
