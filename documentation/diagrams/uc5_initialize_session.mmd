sequenceDiagram
  actor GU as Guest
  participant F as :Frontend
  participant SI as :Google Sign-In
  participant US as :Users
  participant UDB as :Users DB

  GU->>+F: tap "Sign in with Google"
  F->>+SI: getCredential(GetGoogleIdOption)
  alt Guest picks an account
    SI-->>F: Google ID token
    F->>+US: POST /user/auth/google { idToken }
    US->>+SI: verifyIdToken(idToken, audience: client ID)
    alt token valid
      SI-->>US: payload { sub, name, given_name, family_name }
      US->>+UDB: users.findOneAndUpdate({ googleId: sub }, { $setOnInsert: { name } }, { upsert: true })
      UDB-->>-US: user (created on the first sign-in)
      US->>US: jwt.sign({ subject: user ID, expiresIn: 7 days })
      US-->>F: 200 { sessionId: JWT }
      F->>F: store the JWT for later requests
      F-->>GU: the dashboard (now a Signed-in User)
    else token rejected
      SI-->>-US: invalid token
      US-->>-F: 401 { message: "Login failed." }
      F-->>GU: "Sign-in failed, try again"
    end
  else Guest cancels
    SI-->>-F: cancelled
    F-->>-GU: stays on the sign-in screen
  end
