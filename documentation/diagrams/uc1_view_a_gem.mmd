sequenceDiagram
  actor U as Signed-in User
  participant F as :Frontend
  participant G as :Gems
  participant GDB as :Gems DB
  participant CDB as :Comments DB

  U->>+F: open the discovery map
  F->>+G: GET /gem/within?south&west&north&east&limit
  G->>+GDB: gems.find({ location: $geoWithin map area }).sort({ score: -1 }).limit(limit)
  GDB-->>-G: gems
  G-->>-F: 200 [gems]
  F-->>-U: a marker per gem

  U->>+F: tap the marker of gem places/{pk}
  F->>+G: GET /gem?name=places/{pk}
  G->>+GDB: gems.findOne({ name })
  GDB-->>-G: gem, or null
  alt gem found
    G-->>F: 200 gem
    F->>G: GET /gem/{pk}/comments
    G->>+GDB: gems.exists({ name })
    GDB-->>-G: true
    G->>+CDB: comments.find({ gem: name }).sort({ createdAt: 1 })
    CDB-->>-G: comments
    G-->>F: 200 [{ id, body, author, authorName }]
    F-->>U: info sheet: name, type, description, Gem Score, comments
  else no such gem (deleted since the map loaded)
    G-->>-F: 404 { message: "No such Gem." }
    F-->>-U: "This gem is no longer available"
  end
