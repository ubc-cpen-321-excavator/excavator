sequenceDiagram
  actor U as Signed-in User
  participant F as :Frontend
  participant G as :Gems
  participant DB as :Database

  U->>+F: open the discovery map
  F->>+G: GET /gem/within (visible map area)
  alt map area valid
    G->>+DB: find gems in the area, highest Gem Score first
    alt database available
      DB-->>G: gems
      G-->>F: 200 [gems]
      F-->>U: a marker per gem
    else database error
      DB-->>-G: error
      G-->>F: 500 "Get Gems failed."
      F-->>U: "Couldn't load gems, try again"
    end
  else map area invalid (e.g. crosses the date line)
    G-->>-F: 400 "Invalid bounds."
    F-->>-U: "Zoom in to see gems"
  end

  U->>+F: tap the marker of gem places/{pk}
  F->>+G: GET /gem?name=places/{pk}
  G->>+DB: find gem by name
  alt gem found
    DB-->>G: gem
    G-->>F: 200 gem
    F->>G: GET /gem/{pk}/comments
    G->>DB: find the gem's comments, oldest first
    alt comments loaded
      DB-->>G: comments
      G-->>F: 200 [comments]
      F-->>U: gem details, Gem Score and comments
    else gem deleted in the meantime
      DB-->>G: no gem
      G-->>F: 404 "No such Gem."
      F-->>U: "This gem is no longer available"
    else database error
      DB-->>G: error
      G-->>F: 500 "Get comments failed."
      F-->>U: gem details and Gem Score, "Couldn't load comments"
    end
  else no such gem (deleted since the map loaded)
    DB-->>G: none
    G-->>F: 404 "No such Gem."
    F-->>U: "This gem is no longer available", marker removed
  else database error
    DB-->>-G: error
    G-->>-F: 500 "Get Gem failed."
    F-->>-U: "Couldn't load this gem, try again"
  end
  Note over U,DB: If the server can't be reached, the Frontend shows "No connection, try again"
